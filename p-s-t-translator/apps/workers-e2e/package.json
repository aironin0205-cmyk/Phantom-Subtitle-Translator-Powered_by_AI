{
  "name": "@p-s-t-translator/workers-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "workers-e2e",
    "implicitDependencies": [
      "workers"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/workers-e2e/jest.config.ts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "workers:build",
          "workers:serve"
        ]
      }
    }
  }
}
